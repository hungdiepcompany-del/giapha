{
  "name": "web-gia-pha-backup-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "vars": {
    "BACKUP_SERVICE_MODE": "scaffold"
  },
  "secrets": {
    "required": [
      "BACKUP_SERVICE_INTERNAL_TOKEN"
    ]
  },
  "env": {
    "fixture-local": {
      "vars": {
        "BACKUP_SERVICE_MODE": "fixture-local"
      },
      "r2_buckets": [
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "gia-pha-backup-fixture-placeholder",
          "preview_bucket_name": "gia-pha-backup-fixture-preview-placeholder",
          "remote": false
        }
      ],
      "secrets": {
        "required": [
          "BACKUP_SERVICE_INTERNAL_TOKEN",
          "BACKUP_ENCRYPTION_KEY_B64"
        ]
      }
    }
  }
}
